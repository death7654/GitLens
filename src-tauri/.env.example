# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# ── Model provider ────────────────────────────────────────────────────────────
# Choose which AI backend the pipeline uses.
# Valid values: gemini | bob | openai
MODEL_PROVIDER=gemini

# ── Gemini (required when MODEL_PROVIDER=gemini) ──────────────────────────────
GEMINI_API_KEY=

# ── Bob Shell (required when MODEL_PROVIDER=bob) ──────────────────────────────
# Create an Inference-scoped API key at https://bob.ibm.com (API key management).
# The env var name is BOB_API_KEY — this is the official name used by the
# bob CLI; see https://bob.ibm.com/docs/shell/getting-started/install-and-setup
BOB_API_KEY=

# ── OpenAI-compatible / local LLM (required when MODEL_PROVIDER=openai) ───────
# Any server that exposes the /v1/chat/completions endpoint works:
# Ollama, llama.cpp, LM Studio, vLLM, Jan, or the real OpenAI API.
#
# OPENAI_BASE_URL defaults to http://localhost:11434/v1 (Ollama).
# Set it to the root of any other compatible server's v1 endpoint.
#
# OPENAI_API_KEY is optional for local servers.  For the real OpenAI API set
# it to your sk-... key.  Omit or leave blank to send requests with no auth.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
# Model name sent in every request.  Required when MODEL_PROVIDER=openai
# because the default is "gemini-flash-latest" (only valid for Gemini).
# Examples: gpt-4o, gpt-4o-mini, llama3, mistral, gemma3
GITLENS_MODEL_ID=gpt-4o

# ── Model temperature overrides ───────────────────────────────────────────────
# Both values must be floats in [0.0, 2.0].  Omit to keep the built-in defaults.
# Narration step (default 0.3) — creative prose, so a little warmth is fine.
GITLENS_NARRATION_TEMPERATURE=0.3
# Ranking step (default 0.1) — structured scoring, keep it low for consistency.
GITLENS_RANKING_TEMPERATURE=0.1

# ── Reasoning / thinking support ──────────────────────────────────────────────
# Master switch.  Set to "true" or "1" to pass reasoning parameters to the
# model on the ranking call.  When false (default) no extra fields are sent
# and the request bytes are identical to the pre-reasoning build.
GITLENS_REASONING_ENABLED=false

# Maximum tokens for the final answer / JSON-extraction pass (default 4096).
GITLENS_MAX_OUTPUT_TOKENS=4096

# Soft cap on reasoning / thinking tokens (default 2048).
# Maps to reasoning_effort "low" (<512), "medium" (<2048), or "high" (≥2048)
# for OpenAI o-series; used directly as max_tokens for open-source backends.
GITLENS_MAX_REASONING_TOKENS=2048

# Temperature applied during the reasoning pass only (default 0.6).
# The extraction / final-answer pass continues to use GITLENS_RANKING_TEMPERATURE.
GITLENS_REASONING_TEMPERATURE=0.6

# Two-call mode: (a) free-form reasoning, then (b) strict JSON extraction.
# Set to "true" for local reasoning models (Qwen3, DeepSeek-R1, QwQ) where
# you want the chain-of-thought surfaced in meta.reasoning_text and the JSON
# extraction pinned to temperature 0 for reproducibility.
# Keep "false" (default) for cloud models with internal reasoning (OpenAI
# o-series, Gemini thinking mode) — they reason in a single call.
GITLENS_SPLIT_REASONING_FROM_EXTRACTION=false

# ── Quick-start presets ───────────────────────────────────────────────────────
# Uncomment ONE block below and adjust as needed.

# OpenAI o3-mini (reasoning built-in — single-call mode)
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# GITLENS_MODEL_ID=o3-mini
# GITLENS_REASONING_ENABLED=true
# GITLENS_MAX_REASONING_TOKENS=2048

# Local llama.cpp + Qwen3 (split mode to surface chain-of-thought)
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8080/v1
# GITLENS_MODEL_ID=qwen3-14b
# GITLENS_REASONING_ENABLED=true
# GITLENS_SPLIT_REASONING_FROM_EXTRACTION=true
# GITLENS_MAX_REASONING_TOKENS=4096
# GITLENS_REASONING_TEMPERATURE=0.6

# Ollama + gemma3 (thinking via chat_template_kwargs, auto-detected)
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# GITLENS_MODEL_ID=gemma3:12b
# GITLENS_REASONING_ENABLED=true

# OpenRouter + DeepSeek-R1 (uses reasoning.max_tokens wire format)
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# GITLENS_MODEL_ID=deepseek/deepseek-r1
# GITLENS_REASONING_ENABLED=true
# GITLENS_MAX_REASONING_TOKENS=8192
# GITLENS_SPLIT_REASONING_FROM_EXTRACTION=true
