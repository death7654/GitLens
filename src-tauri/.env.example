# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# ── Model provider ────────────────────────────────────────────────────────────
# Choose which AI backend the pipeline uses.
# Valid values: gemini | bob | openai
MODEL_PROVIDER=gemini

# ── Gemini (required when MODEL_PROVIDER=gemini) ──────────────────────────────
GEMINI_API_KEY=

# ── Bob Shell (required when MODEL_PROVIDER=bob) ──────────────────────────────
# Create an Inference-scoped API key at https://bob.ibm.com (API key management).
# The env var name is BOB_API_KEY — this is the official name used by the
# bob CLI; see https://bob.ibm.com/docs/shell/getting-started/install-and-setup
BOB_API_KEY=

# ── OpenAI-compatible / local LLM (required when MODEL_PROVIDER=openai) ───────
# Any server that exposes the /v1/chat/completions endpoint works:
# Ollama, llama.cpp, LM Studio, vLLM, Jan, or the real OpenAI API.
#
# OPENAI_BASE_URL defaults to http://localhost:11434/v1 (Ollama).
# Set it to the root of any other compatible server's v1 endpoint.
#
# OPENAI_API_KEY is optional for local servers.  For the real OpenAI API set
# it to your sk-... key.  Omit or leave blank to send requests with no auth.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
# Model name sent in every request.  Required when MODEL_PROVIDER=openai
# because the default is "gemini-flash-latest" (only valid for Gemini).
# Examples: gpt-4o, gpt-4o-mini, llama3, mistral, gemma3
GITLENS_MODEL_ID=gpt-4o

# ── Model temperature overrides ───────────────────────────────────────────────
# Both values must be floats in [0.0, 2.0].  Omit to keep the built-in defaults.
# Narration step (default 0.3) — creative prose, so a little warmth is fine.
GITLENS_NARRATION_TEMPERATURE=0.3
# Ranking step (default 0.1) — structured scoring, keep it low for consistency.
GITLENS_RANKING_TEMPERATURE=0.1
