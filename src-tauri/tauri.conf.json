{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitlens",
  "version": "0.1.0",
  "identifier": "com.wirecoffins.gitlens",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GitLens",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}